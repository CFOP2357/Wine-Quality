name: wine-quality

python_env: python_env.yaml

entry_points:
  main:
    parameters:
      model:            {type: string, default: linear}   # linear | tree | rf | xgb
      seed:             {type: float,  default: 42}
      n_estimators:     {type: float,  default: 200}      # [rf, xgb]
      max_depth:        {type: float,  default: -1}       # [tree, rf, xgb]; -1 = sin limite
      min_samples_leaf: {type: float,  default: 1}        # [tree, rf]
      learning_rate:    {type: float,  default: 0.1}      # [xgb]
      fit_intercept:    {type: string, default: "true"}   # [linear]
      imputer:          {type: string, default: median}       # median | mean | knn
      normalizer:       {type: string, default: yeo-johnson}  # yeo-johnson | none
      scaler:           {type: string, default: standard}     # standard | minmax | none
      overfit_threshold: {type: float, default: 3.0}          # % brecha RMSE val vs train
      early_stopping:   {type: float, default: -1}            # [xgb] rondas sin mejora; -1 = off
    command: >-
      python -m wine_quality.modeling.train
      --model {model}
      --seed {seed}
      --n-estimators {n_estimators}
      --max-depth {max_depth}
      --min-samples-leaf {min_samples_leaf}
      --learning-rate {learning_rate}
      --fit-intercept {fit_intercept}
      --imputer {imputer}
      --normalizer {normalizer}
      --scaler {scaler}
      --overfit-threshold {overfit_threshold}
      --early-stopping {early_stopping}
